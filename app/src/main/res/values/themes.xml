<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MathStars2" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/gold_light</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MathStars2.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MathStars2" parent="Base.Theme.MathStars2" />
</resources>