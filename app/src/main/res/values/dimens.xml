<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gap between a floating overlay and the screen edge, added on top of window insets. -->
    <dimen name="overlay_edge_margin">16dp</dimen>
    <!-- Extra inset for hub cards, added on top of system-bar insets so tiles do not hug the screen edge. -->
    <dimen name="hub_content_padding">24dp</dimen>
    <!-- Extra gap between the last hub card and the overlaid version label when scrolled to the end. -->
    <dimen name="hub_version_clearance">16dp</dimen>
</resources>
