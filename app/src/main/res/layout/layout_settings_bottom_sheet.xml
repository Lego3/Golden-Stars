<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/customize_star"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="?attr/colorPrimary" />

        <!-- Geometry Controls -->
        <LinearLayout
            android:id="@+id/geometryControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/dots_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dotsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/dots_hint"
                android:stepSize="1.0"
                android:value="5.0"
                android:valueFrom="5.0"
                android:valueTo="100.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/skips_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/skipsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/skips_hint"
                android:value="2.0"
                android:valueFrom="1.0"
                android:valueTo="50.0"
                android:stepSize="1.0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/colorOutlineVariant"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Spirograph geometry -->
        <LinearLayout
            android:id="@+id/spirographControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/spirograph_fixed_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/fixedRadiusSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/spirograph_fixed_hint"
                android:stepSize="1.0"
                android:value="96.0"
                android:valueFrom="20.0"
                android:valueTo="180.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/spirograph_rolling_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/rollingRadiusSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/spirograph_rolling_hint"
                android:stepSize="1.0"
                android:value="32.0"
                android:valueFrom="8.0"
                android:valueTo="90.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/spirograph_pen_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/penOffsetSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/spirograph_pen_hint"
                android:stepSize="1.0"
                android:value="32.0"
                android:valueFrom="0.0"
                android:valueTo="100.0" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInside"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/spirograph_roll_inside"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/colorOutlineVariant"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Style Controls -->
        <LinearLayout
            android:id="@+id/starStyleControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFilled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filled"
                android:checked="true"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/line_thickness"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/thicknessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/line_thickness"
                android:value="8.0"
                android:valueFrom="2.0"
                android:valueTo="24.0" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/color"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <View
                    android:id="@+id/colorGold"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/swatch_gold"
                    android:clickable="true"
                    android:contentDescription="@string/color_gold"
                    android:focusable="true" />
                <View
                    android:id="@+id/colorSilver"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/swatch_silver"
                    android:clickable="true"
                    android:contentDescription="@string/color_silver"
                    android:focusable="true" />
                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/swatch_blue"
                    android:clickable="true"
                    android:contentDescription="@string/color_blue"
                    android:focusable="true" />
                <View
                    android:id="@+id/colorGreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/swatch_green"
                    android:clickable="true"
                    android:contentDescription="@string/color_green"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/close" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
