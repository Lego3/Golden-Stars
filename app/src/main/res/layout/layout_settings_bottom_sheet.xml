<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/customize_star"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="?attr/colorPrimary" />

        <!-- Geometry Controls -->
        <LinearLayout
            android:id="@+id/geometryControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/dots_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dotsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="5.0"
                android:valueFrom="3.0"
                android:valueTo="100.0"
                android:stepSize="1.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/skips_hint"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/skipsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="2.0"
                android:valueFrom="1.0"
                android:valueTo="50.0"
                android:stepSize="1.0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/colorOutlineVariant" />
        </LinearLayout>

        <!-- Style Controls -->
        <LinearLayout
            android:id="@+id/starStyleControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFilled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filled"
                android:checked="true"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/line_thickness"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/thicknessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="8.0"
                android:valueFrom="2.0"
                android:valueTo="24.0" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/color"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <View
                    android:id="@+id/colorGold"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@android:color/holo_orange_light" />
                <View
                    android:id="@+id/colorSilver"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@android:color/darker_gray" />
                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@android:color/holo_blue_light" />
                <View
                    android:id="@+id/colorGreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@android:color/holo_green_light" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/close" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
